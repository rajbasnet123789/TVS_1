# ==============================================================================
# POULTRY MONITORING SYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and modify the values for your environment.
# Run 'openssl rand -hex 32' to generate secure random keys for passwords/secrets.

# ------------------------------------------------------------------------------
# 1. CORE NETWORK & DOMAIN SETUP
# ------------------------------------------------------------------------------
# Domain (Set to your registered domain, e.g., poultry.yourdomain.com for HTTPS)
# For local testing, use 'localhost'.
DOMAIN=localhost

# Tailscale (Optional: Generate auth key at https://login.tailscale.com/admin/settings/keys)
TAILSCALE_AUTH_KEY=<change-me>

# ------------------------------------------------------------------------------
# 2. DATABASE CREDENTIALS (USE SECURE RANDOM PASSWORDS IN PRODUCTION)
# ------------------------------------------------------------------------------
# PostgreSQL Database Password
POSTGRES_PASSWORD=<change-me>

# InfluxDB Time-Series Credentials
INFLUX_PASSWORD=<change-me>
INFLUX_TOKEN=<change-me>
INFLUX_ORG=poultry
INFLUX_BUCKET=detections

# Media Storage (Local filesystem path on server host/volume)
MEDIA_ROOT=/var/opt/poultry/media

# ------------------------------------------------------------------------------
# 3. CV-ENGINE (COMPUTER VISION PIPELINE)
# ------------------------------------------------------------------------------
# cv-engine reads camera configs from business backend via HTTP.
# InfluxDB, JWT, and MQTT are shared with the backend.
CV_ENGINE_URL=http://localhost:8700

# Shared API key for authenticating cv-engine → backend internal endpoint calls.
# Generate with: openssl rand -hex 32
# Must be set to the same value in both backend and cv-engine in production.
CV_ENGINE_API_KEY=<change-me>

# RTSP password for camera streams (used by cv-engine FFmpeg)
RTSP_PASSWORD=<change-me>

# Inference speed tuning: resolution to run YOLO at (smaller = faster), and
# minimum time between inference runs (skip frames in between).
INFERENCE_IMGSZ=640
INFERENCE_MIN_INTERVAL_MS=400
# How often cv-engine pushes live per-camera counts to the backend (seconds).
COUNTS_PUSH_INTERVAL_SECONDS=1
# Live count = distinct track IDs seen per camera in the last N seconds.
# This smooths per-frame YOLO jitter (occlusion, missed frames) instead of
# showing a raw box count that fluctuates. A longer window keeps the count
# stable while birds are merely occluded or stationary.
LIVE_COUNT_WINDOW_SECONDS=60
# If a camera stops reporting for this many seconds, its live count shows 0
# (prevents stale numbers for offline/stalled cameras). Must be >= window.
LIVE_COUNT_TTL_SECONDS=90
# FFmpeg capture rate in fps. Should be low (2-5); inference is throttled by
# INFERENCE_MIN_INTERVAL_MS, so frames between inferences are skipped.
CAPTURE_FPS=5
# How often cv-engine re-registers camera streams in go2rtc (seconds). go2rtc
# streams are in-memory because its config is mounted read-only, so this heals
# feeds after a go2rtc restart. Failed registrations retry every ~30s instead.
GO2RTC_REGISTER_REFRESH_SECONDS=300

# ------------------------------------------------------------------------------
# 4. MQTT (MOSQUITTO) BROKER DETAILS
# ------------------------------------------------------------------------------
MQTT_BROKER=mosquitto
MQTT_PORT=1883
# MQTT username and password (generate password using mosquitto_passwd)
MQTT_USERNAME=cv_engine
MQTT_PASSWORD=<change-me>

# ------------------------------------------------------------------------------
# 5. SECURITY & AUTHENTICATION (CRITICAL FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Default Super Admin Password (Use a strong password for initial admin@poultry.farm login)
DEFAULT_ADMIN_PASSWORD=<change-me>

# JWT Signing Secret (Generate using: openssl rand -hex 32)
JWT_SECRET=<change-me>
JWT_ALGORITHM=HS256

# Database Encryption Key and Salt (Generate using: openssl rand -hex 32)
ENCRYPTION_KEY=<change-me>
ENCRYPTION_SALT=<change-me>

# Token Expirations
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie Security (MUST be set to 'true' in production over HTTPS)
COOKIES_SECURE=false

# ------------------------------------------------------------------------------
# 6. CORS & FRONTEND API ENDPOINTS
# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma-separated. For prod, set to https://poultry.yourdomain.com)
CORS_ORIGINS=http://localhost:3000

# Frontend builds endpoints (For prod, set to https://poultry.yourdomain.com)
VITE_API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 7. OBSERVABILITY, MONITORING & BACKUPS
# ------------------------------------------------------------------------------
# Sentry DSN (Optional error tracking: e.g., https://...@...ingest.sentry.io/...)
SENTRY_DSN=

# Logging Level (Use 'INFO' or 'DEBUG' for local dev, 'WARNING' for production)
LOG_LEVEL=INFO
DB_ECHO=false
DEBUG=true
ENVIRONMENT=development

# Automated Backups (stored inside poultry_backups volume)
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14

# ------------------------------------------------------------------------------
# 8. OPTIONAL SYSTEM INTEGRATIONS
# ------------------------------------------------------------------------------
# NVR ONVIF auto-discovery credentials
NVR_HOST=
NVR_USERNAME=
NVR_PASSWORD=

# Google Single Sign-On (OAuth credentials)
GOOGLE_CLIENT_ID=
